<?xml version="1.0" encoding="utf-8"?>
<!-- canRetrieveWindowContent lets the service read the chat text on screen, but only when the
     user taps the floating bubble. flagIncludeNotImportantViews helps with chat apps that
     mark message bubbles as not important for accessibility. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagIncludeNotImportantViews|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:description="@string/service_description"
    android:notificationTimeout="100" />
